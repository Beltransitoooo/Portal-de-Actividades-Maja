# Variables del frontend (Vite). Copia este archivo como .env y ajusta los valores.
# Nota: todo lo que empieza con VITE_ queda visible en el navegador; nunca pongas secretos aquí.

# URL del backend (FastAPI). Por defecto: http://localhost:8000
VITE_API_URL=http://localhost:8000

# Client ID de OAuth de Google (público). Por defecto se usa el configurado en src/main.jsx
VITE_GOOGLE_CLIENT_ID=
