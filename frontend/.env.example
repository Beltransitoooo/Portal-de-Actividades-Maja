# Variables del frontend (Vite). Copia este archivo como .env y ajusta los valores.
# Nota: todo lo que empieza con VITE_ queda visible en el navegador; nunca pongas secretos aquí.

# URL del backend (FastAPI). Por defecto: http://localhost:8000
VITE_API_URL=http://localhost:8000

# Ambientes:
# - Compartido: el servidor del equipo. Su URL se fija al construir la imagen
#   (variable VITE_API_URL de docker-compose).
# - Desarrollo: cada quien en su Mac con `npm run dev` (http://localhost:5173).
#   Crea frontend/.env.development.local (git no lo sube) con:
#     VITE_API_URL=http://<IP del servidor compartido>:8000
#   Así tus cambios de frontend solo los ves tú, usando los datos del servidor compartido.

# Client ID de OAuth de Google (público). Por defecto se usa el configurado en src/main.jsx
VITE_GOOGLE_CLIENT_ID=
